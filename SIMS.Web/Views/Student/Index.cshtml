@using System.Linq
@model List<SIMS.Web.Models.Student>
@{
    ViewData["Title"] = "Students";
    var role = Context.Session.GetString("Role");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="page-title">Student Directory</div>
        <div class="page-subtitle">@Model.Count registered student(s)</div>
    </div>
    @if (role == "Admin")
    {
        <a asp-controller="Admin" asp-action="RegisterStudent" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Register Student
        </a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 d-block mb-3"></i>
                No students found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Program</th>
                            <th>Enrolled</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#1a2744,#2563eb);display:flex;align-items:center;justify-content:center;color:white;font-size:.75rem;font-weight:700;flex-shrink:0;">
                                            @(s.FirstName?.Length > 0 ? s.FirstName[0] : '?')@(s.LastName?.Length > 0 ? s.LastName[0] : '?')
                                        </div>
                                        <div>
                                            <strong>@s.FirstName @s.LastName</strong>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="text-muted">@s.Username</span></td>
                                <td>@s.Email</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(s.AcademicProgram))
                                    {
                                        <span class="badge bg-primary">@s.AcademicProgram</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><span class="text-muted">@s.EnrollmentDate.ToString("MMM dd, yyyy")</span></td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Detail" asp-route-id="@s.UserId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (role == "Admin")
                                        {
                                            <a asp-action="Edit" asp-route-id="@s.UserId"
                                               class="btn btn-sm btn-warning">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        <a asp-action="AcademicRecord" asp-route-id="@s.UserId"
                                           class="btn btn-sm btn-secondary">
                                            <i class="bi bi-journal-text"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
