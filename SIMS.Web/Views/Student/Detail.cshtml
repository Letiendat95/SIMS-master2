@model SIMS.Web.Models.Student
@{
    ViewData["Title"] = "Student Profile";
    var role = Context.Session.GetString("Role");
}

<div class="row g-4">
    <!-- Profile card -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="profile-header">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <div class="profile-avatar" style="background:none;padding:0;">
                        <img src="@Model.ProfilePictureUrl" alt="Avatar"
                             style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                    </div>
                }
                else
                {
                    <div class="profile-avatar">
                        @(Model.FirstName?.Length > 0 ? Model.FirstName[0] : '?')@(Model.LastName?.Length > 0 ? Model.LastName[0] : '?')
                    </div>
                }
                <div class="profile-name">@Model.FirstName @Model.LastName</div>
                <div class="profile-role">Student</div>
            </div>
            <div class="card-body">
                <div class="profile-field">
                    <div class="profile-field-label">Username</div>
                    <div class="profile-field-value">@Model.Username</div>
                </div>
                <div class="profile-field">
                    <div class="profile-field-label">Email</div>
                    <div class="profile-field-value">@Model.Email</div>
                </div>
                <div class="profile-field">
                    <div class="profile-field-label">Phone</div>
                    <div class="profile-field-value">
                        @(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)
                    </div>
                </div>
                <div class="profile-field">
                    <div class="profile-field-label">Date of Birth</div>
                    <div class="profile-field-value">
                        @(Model.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "—")
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                @if (role == "Admin")
                {
                    <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                }
                <a asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>
    </div>

    <!-- Details -->
    <div class="col-md-8">
        <!-- Academic info -->
        <div class="card mb-4">
            <div class="card-header accent-blue">
                <h5><i class="bi bi-mortarboard-fill me-2"></i>Academic Information</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="profile-field">
                            <div class="profile-field-label">Program</div>
                            <div class="profile-field-value">
                                @if (!string.IsNullOrEmpty(Model.AcademicProgram))
                                {
                                    <span class="badge bg-primary fs-6 px-3">
                                        @Model.AcademicProgram
                                    </span>
                                }
                                else
                                {

                                    <span class="text-muted">—</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-field">
                            <div class="profile-field-label">Enrollment Date</div>
                            <div class="profile-field-value">
                                @Model.EnrollmentDate.ToString("MMMM dd, yyyy")
                            </div>
                        </div>
                    </div>

                    @if (Model.AcademicRecord != null)
                    {
                        <div class="col-md-4">
                            <div class="stat-card">
                                <div class="stat-icon blue"><i class="bi bi-bar-chart-fill"></i></div>
                                <div>
                                    <div class="stat-value">@Model.AcademicRecord.GPA.ToString("F1")</div>
                                    <div class="stat-label">GPA</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-card">
                                <div class="stat-icon green"><i class="bi bi-award-fill"></i></div>
                                <div>
                                    <div class="stat-value">@Model.AcademicRecord.TotalCreditsCompleted</div>
                                    <div class="stat-label">Credits</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-card">
                                <div class="stat-icon amber"><i class="bi bi-calendar-fill"></i></div>
                                <div>
                                    <div class="stat-value">@Model.AcademicRecord.YearStarted</div>
                                    <div class="stat-label">Year Started</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer">
                <a asp-action="AcademicRecord" asp-route-id="@Model.UserId" class="btn btn-primary btn-sm">
                    <i class="bi bi-journal-text"></i> View Academic Records
                </a>
            </div>
        </div>

        <!-- Address -->
        <div class="card">
            <div class="card-header accent-info">
                <h5><i class="bi bi-geo-alt-fill me-2"></i>Contact & Address</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="profile-field">
                            <div class="profile-field-label">Address</div>
                            <div class="profile-field-value">
                                @(string.IsNullOrEmpty(Model.Address) ? "—" : Model.Address)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="profile-field">
                            <div class="profile-field-label">City</div>
                            <div class="profile-field-value">
                                @(string.IsNullOrEmpty(Model.City) ? "—" : Model.City)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="profile-field">
                            <div class="profile-field-label">State / Zip</div>
                            <div class="profile-field-value">
                                @Model.State @Model.ZipCode
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
