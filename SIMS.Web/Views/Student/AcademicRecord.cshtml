@using System.Linq
@model List<SIMS.Web.Models.Enrollment>
@{
    ViewData["Title"] = "Academic Record";
    var record = ViewBag.AcademicRecord as SIMS.Web.Models.AcademicRecord;
}

<div class="page-header">
    <div class="page-title">Academic Record</div>
    <div class="page-subtitle">Your enrolled courses and grades</div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
            <p class="text-muted">No enrollments or grades found.</p>
        </div>
    </div>
}
else
{
    <!-- GPA Card -->
    if (record != null)
    {
        <div class="card mb-4">
            <div class="card-body text-center py-4">
                <div class="text-muted mb-2"><i class="bi bi-award-fill text-primary me-1"></i> Current GPA</div>
                <div style="font-size:3rem;font-weight:700;color:var(--gray-800);">@record.GPA.ToString("F2")</div>
                <div class="text-muted mt-1">
                    @record.TotalCreditsCompleted credits completed
                </div>
            </div>
        </div>
    }

    <!-- Summary stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="bi bi-book-fill"></i></div>
                <div>
                    <div class="stat-value">@Model.Count</div>
                    <div class="stat-label">Total Courses</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon green"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <div class="stat-value">@Model.Count(e => !string.IsNullOrEmpty(e.Grade))</div>
                    <div class="stat-label">Graded</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon amber"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="stat-value">@Model.Count(e => string.IsNullOrEmpty(e.Grade))</div>
                    <div class="stat-label">Pending</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon sky"><i class="bi bi-award-fill"></i></div>
                <div>
                    <div class="stat-value">@Model.Where(e => e.Grade == "A" || e.Grade == "B" || e.Grade == "C" || e.Grade == "D").Sum(e => e.Course?.Credits ?? 0)</div>
                    <div class="stat-label">Credits Earned</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Enrollment table -->
    <div class="card">
        <div class="card-header accent-navy">
            <h5><i class="bi bi-journal-text me-2"></i>Enrolled Courses</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Credits</th>
                            <th>Enrolled</th>
                            <th>Status</th>
                            <th>Grade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-600">@e.Course?.CourseName</div>
                                    <small class="text-muted">@e.Course?.CourseCode</small>
                                </td>
                                <td><span class="badge bg-info">@e.Course?.Credits cr</span></td>
                                <td><span class="text-muted">@e.EnrollmentDate.ToString("MMM dd, yyyy")</span></td>
                                <td>
                                    <span class="badge @(e.Status == "Active" ? "bg-success" : "bg-secondary")">
                                        @e.Status
                                    </span>
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(e.Grade))
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success fs-6 px-3">@e.Grade</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
