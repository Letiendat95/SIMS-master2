@model SIMS.Web.Models.Student
@{
    ViewData["Title"] = "Edit Student";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header accent-warning">
                <h5><i class="bi bi-pencil-fill me-2"></i>Edit Student — @Model.FirstName @Model.LastName</h5>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger mb-4"></div>
                }

                <form asp-action="Edit" asp-route-id="@Model.UserId" method="post" enctype="multipart/form-data">
                    <!-- Profile Picture -->
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                        {
                            <img src="@Model.ProfilePictureUrl" alt="Avatar"
                                 class="rounded-circle border shadow mb-2"
                                 style="width:100px;height:100px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center mb-2"
                                 style="width:100px;height:100px;">
                                <i class="bi bi-person-fill text-white" style="font-size:2.5rem;"></i>
                            </div>
                        }
                        <div>
                            <label class="form-label small text-muted">Profile Picture</label>
                            <input type="file" name="profilePicture" class="form-control form-control-sm"
                                   accept=".jpg,.jpeg,.png,.gif,.webp" />
                            <small class="text-muted">Max 5MB. JPG, PNG, GIF, WebP.</small>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">First Name</label>
                            <input type="text" value="@Model.FirstName" class="form-control" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name</label>
                            <input type="text" value="@Model.LastName" class="form-control" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Username</label>
                            <input type="text" value="@Model.Username" class="form-control" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email Address <span class="text-blue">*</span></label>
                            <input id="email" name="email" type="email"
                                   value="@Model.Email" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number <span class="text-blue">*</span></label>
                            <input id="phoneNumber" name="phoneNumber" type="tel"
                                   value="@(Model.PhoneNumber ?? "")" class="form-control"
                                   placeholder="Enter phone number" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date of Birth</label>
                            <input type="date" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")"
                                   class="form-control" disabled />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Address <span class="text-blue">*</span></label>
                            <input id="address" name="address" type="text"
                                   value="@(Model.Address ?? "")" class="form-control"
                                   placeholder="Enter address" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Academic Program</label>
                            <input type="text" value="@Model.AcademicProgram"
                                   class="form-control" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Enrollment Date</label>
                            <input type="text" value="@Model.EnrollmentDate.ToString("MMM dd, yyyy")"
                                   class="form-control" disabled />
                        </div>
                    </div>

                    <div class="divider mt-4"></div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Detail" asp-route-id="@Model.UserId"
                           class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
