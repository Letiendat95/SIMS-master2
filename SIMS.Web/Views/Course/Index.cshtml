@using System.Linq
@model List<SIMS.Web.Models.Course>
@{
    ViewData["Title"] = "Courses";
    var role = Context.Session.GetString("Role");
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var department = ViewBag.Department as string;
    var credits = ViewBag.Credits as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="page-title">Available Courses</div>
        <div class="page-subtitle">@Model.Count course(s) found</div>
    </div>
    @if (role == "Admin")
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> New Course
        </a>
    }
</div>

<!-- Search & Filters -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Search</label>
                <input type="text" name="search" value="@search" class="form-control"
                       placeholder="Course code, name, or description..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Active" selected="@(status == "Active")">Active</option>
                    <option value="Inactive" selected="@(status == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Department</label>
                <select name="department" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in new[] { "Computer Science", "Mathematics", "Physics", "Business" })
                    {
                        <option value="@dept" selected="@(department == dept)">@dept</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Credits</label>
                <select name="credits" class="form-select">
                    <option value="">All Credits</option>
                    @for (int c = 1; c <= 6; c++)
                    {
                        <option value="@c" selected="@(credits == c)">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(status) || !string.IsNullOrEmpty(department) || credits.HasValue)
        {
            <div class="mt-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> Clear Filters
                </a>
            </div>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-book fs-1 text-muted d-block mb-3"></i>
            <p class="text-muted">No courses available at this time.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="course-card">
                    <div class="course-card-header">
                        <div class="course-code">@course.CourseCode</div>
                        <div class="course-status">@course.Status</div>
                    </div>
                    <div class="course-card-body">
                        <div class="course-name">@course.CourseName</div>
                        <div class="course-desc">@course.Description</div>
                        <div class="course-meta-item mt-1">
                            <i class="bi bi-person-badge"></i>
                            @(course.Faculty != null ? $"{course.Faculty.FirstName} {course.Faculty.LastName}" : "Not assigned")
                        </div>
                        <div class="course-meta">
                            <div class="course-meta-item">
                                <i class="bi bi-award"></i> @course.Credits credits
                            </div>
                            <div class="course-meta-item">
                                <i class="bi bi-people"></i>
                                @course.Enrollments.Count / @course.Capacity
                            </div>
                            <div class="course-meta-item">
                                <i class="bi bi-calendar3"></i>
                                @course.StartDate.ToString("MMM yyyy")
                            </div>
                        </div>
                    </div>
                    <div class="course-card-footer">
                        <a asp-action="Detail" asp-route-id="@course.CourseId"
                           class="btn btn-primary btn-sm w-100">
                            View Details <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
