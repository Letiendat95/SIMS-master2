@using System.Linq
@model SIMS.Web.Models.Course
@{
    var role = Context.Session.GetString("Role");
    var userId = Context.Session.GetString("UserId");
    ViewData["Title"] = "Course Detail";
}

<!-- Course header -->
<div class="card mb-4">
    <div class="card-header accent-navy">
        <h5><i class="bi bi-book-fill me-2"></i>@Model.CourseCode — @Model.CourseName</h5>
        <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">
            @Model.Status
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">@Model.Description</p>
        <div class="mb-4">
            <i class="bi bi-person-badge-fill text-primary me-1"></i>
            <strong>Instructor:</strong>
            @if (Model.Faculty != null)
            {
                <span class="text-muted">@Model.Faculty.FirstName @Model.Faculty.LastName</span>
            }
            else
            {
                <span class="text-muted fst-italic">Not assigned</span>
            }
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon blue"><i class="bi bi-award-fill"></i></div>
                    <div>
                        <div class="stat-value">@Model.Credits</div>
                        <div class="stat-label">Credits</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon green"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <div class="stat-value">@Model.Enrollments.Count</div>
                        <div class="stat-label">Enrolled</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon amber"><i class="bi bi-person-check-fill"></i></div>
                    <div>
                        <div class="stat-value">@(Model.Capacity - Model.Enrollments.Count)</div>
                        <div class="stat-label">Available</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon sky"><i class="bi bi-calendar-range-fill"></i></div>
                    <div>
                        <div class="stat-value">@Model.StartDate.ToString("MMM yy")</div>
                        <div class="stat-label">Start Date</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Enrolled students (Faculty/Admin) -->
@if ((role == "Faculty" || role == "Admin") && Model.Enrollments.Any())
{
    <div class="card mb-4">
        <div class="card-header accent-blue">
            <h5><i class="bi bi-people-fill me-2"></i>Enrolled Students</h5>
            <span class="badge" style="background:rgba(255,255,255,.2);color:white;">
                @Model.Enrollments.Count students
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Email</th>
                            <th>Enrolled</th>
                            <th>Grade</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var en in Model.Enrollments)
                        {
                            <tr>
                                <td><strong>@en.Student?.FirstName @en.Student?.LastName</strong></td>
                                <td><span class="text-muted">@en.Student?.Email</span></td>
                                <td><span class="text-muted">@en.EnrollmentDate.ToShortDateString()</span></td>
                                <td>
                                    @if (string.IsNullOrEmpty(en.Grade))
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@en.Grade</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(en.Status == "Active" ? "bg-success" : "bg-secondary")">
                                        @en.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Assignments -->
<div class="card">
    <div class="card-header accent-warning">
        <h5><i class="bi bi-file-earmark-text me-2"></i>Assignments</h5>
        <div class="d-flex gap-2">
            @if (role == "Student")
            {
                <a asp-controller="Attendance" asp-action="MyAttendance"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-sm btn-secondary">
                    <i class="bi bi-calendar-check"></i> My Attendance
                </a>
            }
            @if (role == "Faculty")
            {
                <a asp-controller="Attendance" asp-action="TakeAttendance"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-sm btn-secondary">
                    <i class="bi bi-calendar-check"></i> Take Attendance
                </a>
                <a asp-controller="Assignment" asp-action="Create"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg"></i> Create Assignment
                </a>
            }
        </div>
    </div>
    <div class="card-body @(Model.Assignments == null || !Model.Assignments.Any() ? "" : "p-0")">
        @if (Model.Assignments == null || !Model.Assignments.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-file-earmark fs-2 d-block mb-2"></i>
                No assignments yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Due Date</th>
                            <th>Submissions</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Assignments)
                        {
                            var expired = a.DueDate < DateTime.Now;
                            <tr>
                                <td><strong>@a.Title</strong></td>
                                <td>
                                    <span class="badge @(expired ? "bg-danger" : "bg-success")">
                                        <i class="bi @(expired ? "bi-clock-history" : "bi-clock")"></i>
                                        @a.DueDate.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">@(a.Submissions?.Count ?? 0) submitted</span>
                                </td>
                                <td class="text-end">
                                    @if (role == "Faculty")
                                    {
                                        <a asp-controller="Assignment" asp-action="Detail"
                                           asp-route-id="@a.AssignmentId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> View Submissions
                                        </a>
                                    }
                                    else if (role == "Student")
                                    {
                                        <a asp-controller="Assignment" asp-action="MyAssignment"
                                           asp-route-id="@a.AssignmentId"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-upload"></i> Submit
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-4 d-flex justify-content-between">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Courses
    </a>

    @if (role == "Admin")
    {
        <form asp-controller="Course" asp-action="DeleteConfirmed"
              asp-route-id="@Model.CourseId" method="post"
              onsubmit="return confirm('Are you sure you want to delete this course? All attendance records, submissions, and related reviews will be permanently deleted..');">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Delete Course
            </button>
        </form>
    }
</div>

<!-- Reviews Section -->
<div class="card mt-4">
    <div class="card-header accent-info">
        <h5><i class="bi bi-star-fill me-2"></i>Course Reviews</h5>
        @if (role == "Student" && int.TryParse(userId, out var studentId))
        {
            var hasReviewed = Model.Reviews?.Any(r => r.StudentId == studentId) ?? false;
            if (!hasReviewed)
            {
                <a asp-controller="CourseReview" asp-action="Create"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-sm btn-light">
                    <i class="bi bi-plus-lg"></i> Write Review
                </a>
            }
        }
    </div>
    <div class="card-body">
        @if (Model.Reviews == null || !Model.Reviews.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-star fs-2 d-block mb-2"></i>
                No reviews yet. Be the first to review!
            </div>
        }
        else
        {
            <!-- Average Rating -->
            <div class="text-center mb-4 p-3" style="background: var(--blue-pale); border-radius: var(--radius-sm);">
                <div class="rating-big">@Model.Reviews.Average(r => r.Rating).ToString("F1")</div>
                <div class="rating-stars mb-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi bi-star@(i <= Math.Round(Model.Reviews.Average(r => r.Rating)) ? "-fill" : "") text-warning"></i>
                    }
                </div>
                <small class="text-muted">@Model.Reviews.Count review(s)</small>
            </div>

            <!-- Reviews List -->
            @foreach (var review in Model.Reviews.OrderByDescending(r => r.ReviewDate))
            {
                <div class="review-item mb-3 p-3" style="background: var(--gray-50); border-radius: var(--radius-sm);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong>@review.Student?.FirstName @review.Student?.LastName</strong>
                            <div class="rating-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= review.Rating ? "-fill" : "") text-warning small"></i>
                                }
                            </div>
                        </div>
                        <small class="text-muted">@review.ReviewDate.ToString("MMM dd, yyyy")</small>
                    </div>
                    <p class="mb-0">@review.Comment</p>
                </div>
            }
        }
    </div>
</div>

<style>
    .rating-big {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--gray-800);
    }
    .rating-stars {
        display: flex;
        gap: 2px;
        justify-content: center;
    }
    .review-item {
        border-left: 3px solid var(--blue);
    }
</style>
