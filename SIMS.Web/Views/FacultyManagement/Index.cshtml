@using System.Linq
@model List<SIMS.Web.Models.Faculty>
@{
    ViewData["Title"] = "Faculty Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="page-title">Faculty Management</div>
        <div class="page-subtitle">@Model.Count instructor(s) registered</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill"></i> Add Faculty
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
    </div>
}

<div class="card">
    <div class="card-header accent-navy">
        <h5><i class="bi bi-person-badge-fill me-2"></i>Faculty List</h5>
        <span class="badge" style="background:rgba(255,255,255,.15);color:white;">
            @Model.Count total
        </span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-person-badge fs-1 d-block mb-3"></i>
                No faculty members found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Faculty</th>
                            <th>Department</th>
                            <th>Email</th>
                            <th>Courses</th>
                            <th>Date Hired</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#059669,#10b981);display:flex;align-items:center;justify-content:center;color:white;font-size:.8rem;font-weight:700;flex-shrink:0;">
                                            @(f.Username?.Length > 0 ? char.ToUpper(f.Username[0]) : '?')
                                        </div>
                                        <div>
                                            <strong>@f.FirstName @f.LastName</strong>
                                            <br /><small class="text-muted">@f.Username</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(f.Department))
                                    {
                                        <span class="badge bg-info">@f.Department</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><span class="text-muted">@f.FirstName @f.LastName</span></td>
                                <td>
                                    <span class="badge bg-primary">
                                        @f.Courses.Count course(s)
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">
                                        @f.DateHired.ToString("MMM dd, yyyy")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Detail" asp-route-id="@f.UserId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@f.UserId"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-action="Delete" method="post"
                                              onsubmit="return confirm('Remove this faculty?')">
                                            <input type="hidden" name="id" value="@f.UserId" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>