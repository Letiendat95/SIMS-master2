@using System.Linq
@model List<SIMS.Web.Models.Enrollment>
@{
    ViewData["Title"] = "Take Attendance";
    var existingAttendance = ViewBag.ExistingAttendance as Dictionary<int, bool>
        ?? new Dictionary<int, bool>();
    var selectedDate = (DateTime)ViewBag.SelectedDate;
}

<div class="page-header">
    <div class="page-title">Take Attendance</div>
    <div class="page-subtitle">@ViewBag.CourseName</div>
</div>

<!-- Date picker -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="d-flex align-items-end gap-3">
            <input type="hidden" name="courseId" value="@ViewBag.CourseId" />
            <div>
                <label class="form-label">Select Date</label>
                <input type="date" name="date" class="form-control"
                       value="@selectedDate.ToString("yyyy-MM-dd")" />
            </div>
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i> Load
            </button>
            <a asp-action="History" asp-route-courseId="@ViewBag.CourseId"
               class="btn btn-secondary">
                <i class="bi bi-clock-history"></i> View History
            </a>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
    </div>
}

<!-- Attendance form -->
<div class="card">
    <div class="card-header accent-blue">
        <h5>
            <i class="bi bi-calendar-check me-2"></i>
            Attendance for @selectedDate.ToString("dddd, dd MMMM yyyy")
        </h5>
        <div class="d-flex gap-2">
            <span class="badge bg-success">Present</span>
            <span class="badge bg-danger">Absent</span>
        </div>
    </div>
    <div class="card-body p-0">
        <form asp-action="SaveAttendance" method="post">
            <input type="hidden" name="courseId" value="@ViewBag.CourseId" />
            <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th>Student</th>
                            <th>Email</th>
                            <th class="text-center" style="width:100px">
                                <span class="text-success fw-bold">Present</span>
                            </th>
                            <th class="text-center" style="width:100px">
                                <span class="text-danger fw-bold">Absent</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var enrollment in Model)
                        {
                            var sid = enrollment.StudentId;
                            var isPresent = !existingAttendance.ContainsKey(sid) || existingAttendance[sid];
                            <tr class="attendance-row">
                                <td class="text-muted">@i</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#1a2744,#2563eb);display:flex;align-items:center;justify-content:center;color:white;font-size:.72rem;font-weight:700;flex-shrink:0;">
                                            @(enrollment.Student?.FirstName?.Length > 0 ? enrollment.Student.FirstName[0] : '?')@(enrollment.Student?.LastName?.Length > 0 ? enrollment.Student.LastName[0] : '?')
                                        </div>
                                        <strong>@enrollment.Student?.FirstName @enrollment.Student?.LastName</strong>
                                    </div>
                                </td>
                                <td><small class="text-muted">@enrollment.Student?.Email</small></td>
                                <td class="text-center">
                                    <div class="form-check d-flex justify-content-center">
                                        <input class="form-check-input" type="radio"
                                               name="attendance[@sid]"
                                               value="true"
                                               style="width:20px;height:20px;cursor:pointer;"
                                        @(isPresent ? "checked" : "") />
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="form-check d-flex justify-content-center">
                                        <input class="form-check-input" type="radio"
                                               name="attendance[@sid]"
                                               value="false"
                                               style="width:20px;height:20px;cursor:pointer;"
                                        @(!isPresent ? "checked" : "") />
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-check-circle"></i> Save Attendance
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </form>
    </div>
</div>
