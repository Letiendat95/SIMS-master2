@model List<SIMS.Web.Models.Role>
@{
    ViewData["Title"] = "Manage Roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="page-title">Manage Roles</div>
        <div class="page-subtitle">View roles and manage user assignments</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @foreach (var role in Model)
    {
        var iconClass = role.RoleName switch
        {
            "Admin" => "bi-shield-fill-check text-danger",
            "Faculty" => "bi-person-badge-fill text-primary",
            "Student" => "bi-mortarboard-fill text-success",
            _ => "bi-shield-lock text-secondary"
        };
        var colorClass = role.RoleName switch
        {
            "Admin" => "accent-navy",
            "Faculty" => "accent-blue",
            "Student" => "accent-success",
            _ => "accent-warning"
        };

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header @colorClass">
                    <h5 class="mb-0"><i class="bi @iconClass me-2"></i>@role.RoleName</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">@role.Description</p>
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon blue me-3" style="width:48px;height:48px;">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <div class="stat-value">@role.Users.Count</div>
                            <div class="stat-label">Users assigned</div>
                        </div>
                    </div>
                    <a asp-action="RoleUsers" asp-route-roleId="@role.RoleId"
                       class="btn btn-outline-primary w-100">
                        <i class="bi bi-eye me-1"></i> View Users
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>
