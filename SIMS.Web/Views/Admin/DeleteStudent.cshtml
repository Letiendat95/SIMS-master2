@model SIMS.Web.Models.Student
@{
    ViewData["Title"] = "Delete Student";
}

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5><i class="bi bi-exclamation-triangle me-2"></i>Delete Student</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-circle me-2"></i>
            Are you sure you want to delete this student? This action cannot be undone.
        </div>

        <dl class="row">
            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Program</dt>
            <dd class="col-sm-9">@(Model.AcademicProgram ?? "—")</dd>

            <dt class="col-sm-3">Enrolled</dt>
            <dd class="col-sm-9">@Model.EnrollmentDate.ToString("MMM dd, yyyy")</dd>
        </dl>

        <form asp-action="DeleteStudent" asp-route-id="@Model.UserId" method="post">
            <input type="hidden" asp-for="UserId" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle me-1"></i> Cancel
            </a>
        </form>
    </div>
</div>
