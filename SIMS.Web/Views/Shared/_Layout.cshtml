<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SIMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @{
        var userRole = Context.Session.GetString("Role");
        var userId = Context.Session.GetString("UserId");
        var isLoggedIn = !string.IsNullOrEmpty(userId);
        var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
        var avatarUrl = Context.Session.GetString("ProfilePictureUrl") ?? "";
        var fullName = Context.Session.GetString("FullName") ?? userRole + " Account";
    }

    @if (isLoggedIn)
    {
        <aside class="sims-sidebar" id="sidebar">
            <!-- Brand -->
            <div class="sidebar-brand">
                <a class="sidebar-brand-title" href="@(userRole == "Admin" ? "/Admin/Index" : userRole == "Faculty" ? $"/Faculty/Detail/{userId}" : $"/Student/Detail/{userId}")">
                    <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
                    SIMS
                </a>
                <div class="sidebar-brand-sub">Student Info System</div>
            </div>

            <!-- User -->
            <div class="sidebar-user">
                @if (!string.IsNullOrEmpty(avatarUrl))
                {
                    <div class="sidebar-avatar" style="background:none;padding:0;">
                        <img src="@avatarUrl" alt="Avatar"
                             style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                    </div>
                }
                else
                {
                    <div class="sidebar-avatar"><i class="bi bi-person-fill"></i></div>
                }
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">@fullName</div>
                    <div class="sidebar-user-role">@userRole</div>
                </div>
            </div>

            <!-- Nav -->
            <nav class="sidebar-nav">
                @if (userRole == "Admin" || userRole == "Faculty")
                {
                    <div class="sidebar-section-label">Management</div>
                    <a class="nav-link @(pageTitle!.Contains("Student") ? "active" : "")"
                       asp-controller="Student" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Students
                    </a>
                    <a class="nav-link @(pageTitle.Contains("Course") ? "active" : "")"
                       asp-controller="Course" asp-action="Index">
                        <i class="bi bi-book-fill"></i> Courses
                    </a>
                    @if (userRole == "Faculty")
                    {
                        <a class="nav-link @(pageTitle.Contains("Profile") ? "active" : "")"
                           asp-controller="Faculty" asp-action="Detail" asp-route-id="@userId">
                            <i class="bi bi-person-circle"></i> My Profile
                        </a>
                        <a class="nav-link @(pageTitle.Contains("Attendance") ? "active" : "")"
                           asp-controller="Attendance" asp-action="Index">
                            <i class="bi bi-calendar-check-fill"></i> Attendance
                        </a>
                        <a class="nav-link @(pageTitle.Contains("Grade") ? "active" : "")"
                           asp-controller="Faculty" asp-action="InputGrade">
                            <i class="bi bi-pencil-square"></i> Input Grade
                        </a>
                    }
                }

                @if (userRole == "Student")
                {
                    <div class="sidebar-section-label">My Learning</div>
                    <a class="nav-link @(pageTitle.Contains("Course") ? "active" : "")"
                       asp-controller="Course" asp-action="Index">
                        <i class="bi bi-book-fill"></i> My Courses
                    </a>
                    <a class="nav-link @(pageTitle.Contains("Academic") ? "active" : "")"
                       asp-controller="Student" asp-action="AcademicRecord" asp-route-id="@userId">
                        <i class="bi bi-journal-text"></i> Academic Record
                    </a>
                    <a class="nav-link @(pageTitle.Contains("Profile") ? "active" : "")"
                       asp-controller="Student" asp-action="Detail" asp-route-id="@userId">
                        <i class="bi bi-person-circle"></i> My Profile
                    </a>
                    <a class="nav-link @(pageTitle.Contains("Review") ? "active" : "")"
                       asp-controller="CourseReview" asp-action="MyReviews">
                        <i class="bi bi-star-fill"></i> My Reviews
                    </a>
                }

                <div class="sidebar-section-label">Activity</div>
                <a class="nav-link @(pageTitle.Contains("Notifications") ? "active" : "")"
                   asp-controller="Notification" asp-action="Index">
                    <i class="bi bi-bell-fill"></i> Notifications
                </a>

                @if (userRole == "Admin")
                {
                    <div class="sidebar-section-label">Administration</div>
                    <a class="nav-link @(pageTitle.Contains("Admin Dashboard") ? "active" : "")"
                       asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                    <a class="nav-link @(pageTitle.Contains("Faculty Management") ? "active" : "")"
                       asp-controller="FacultyManagement" asp-action="Index">
                        <i class="bi bi-person-badge-fill"></i> Faculty
                    </a>
                    <a class="nav-link @(pageTitle.Contains("Assign Student to Course") ? "active" : "")"
                       asp-controller="Admin" asp-action="AssignStudentToCourse">
                        <i class="bi bi-person-plus-fill"></i> Assign Student
                    </a>
                    <a class="nav-link @(pageTitle.Contains("Assign Faculty to Course") ? "active" : "")"
                       asp-controller="Admin" asp-action="AssignFacultyToCourse">
                        <i class="bi bi-person-badge"></i> Assign Faculty
                    </a>
                    <a class="nav-link @(pageTitle.Contains("Import Data") ? "active" : "")"
                       asp-controller="DataImport" asp-action="Index">
                        <i class="bi bi-filetype-csv"></i> Import CSV
                    </a>
                    <a class="nav-link @(pageTitle.Contains("Reports") ? "active" : "")"
                       asp-controller="Report" asp-action="Index">
                        <i class="bi bi-graph-up"></i> Reports
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">
                        <i class="bi bi-box-arrow-left"></i> Sign Out
                    </button>
                </form>
            </div>
        </aside>

        <div class="sims-main">
            <header class="sims-topbar">
                <div>
                    <div class="topbar-title">@pageTitle</div>
                    <div class="topbar-breadcrumb">SIMS / @pageTitle</div>
                </div>
                <div class="topbar-right">
                    <a asp-controller="Notification" asp-action="Index"
                       class="position-relative me-3 text-decoration-none" id="notifBell"
                       style="font-size:1.3rem;color:var(--gray-600);">
                        <i class="bi bi-bell-fill"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                              id="notifBadge" style="display:none;font-size:0.65rem;">
                            0
                        </span>
                    </a>
                    <span class="topbar-badge">
                        <i class="bi bi-shield-check"></i> @userRole
                    </span>
                </div>
            </header>

            <main class="sims-content">
                @RenderBody()
            </main>

            <footer class="sims-footer">
                &copy; 2024 Student Information Management System — All rights reserved.
            </footer>
        </div>
    }
    else
    {
        <div class="login-page">
            @RenderBody()
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function loadNotifCount() {
            try {
                const res = await fetch('/Notification/GetUnreadCount');
                const count = await res.json();
                const badge = document.getElementById('notifBadge');
                if (badge) {
                    if (count > 0) {
                        badge.textContent = count;
                        badge.style.display = 'inline-block';
                    } else {
                        badge.style.display = 'none';
                    }
                }
            } catch (e) {}
        }
        loadNotifCount();
        setInterval(loadNotifCount, 30000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
