@model IEnumerable<SIMS.Web.Models.CourseReview>
@{
    ViewData["Title"] = "My Reviews";
}

<div class="page-header">
    <div class="page-title">
        <i class="bi bi-star-fill text-warning me-2"></i>My Reviews
    </div>
    <div class="page-subtitle">Reviews you've submitted for courses</div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-star" style="font-size: 3rem; color: var(--gray-300);"></i>
            <p class="mt-3 text-muted">You haven't reviewed any courses yet.</p>
            <a asp-controller="Course" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-book"></i> Browse Courses
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var review in Model)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header">
                        <div>
                            <h5 class="mb-0">@review.Course?.CourseName</h5>
                            <small class="text-muted">@review.Course?.CourseCode</small>
                        </div>
                        <div class="rating-display">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star@(i <= review.Rating ? "-fill" : "") text-warning"></i>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="mb-3">@review.Comment</p>
                        <small class="text-muted">
                            <i class="bi bi-calendar"></i> @review.ReviewDate.ToString("MMM dd, yyyy")
                        </small>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-reviewId="@review.ReviewId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this review?');">
                                <input type="hidden" name="reviewId" value="@review.ReviewId" />
                                <input type="hidden" name="courseId" value="@review.CourseId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .rating-display {
        display: flex;
        gap: 2px;
        font-size: 1rem;
    }
</style>
