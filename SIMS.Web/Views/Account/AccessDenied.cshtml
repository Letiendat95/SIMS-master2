@{
    ViewData["Title"] = "Access Denied";
    var role = Context.Session.GetString("Role");
    var userId = Context.Session.GetString("UserId");
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center" style="max-width: 480px;">
        <div style="width:80px;height:80px;background:#fee2e2;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:2rem;color:#ef4444;">
            <i class="bi bi-shield-x"></i>
        </div>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;color:#1e293b;margin-bottom:8px;">
            Access Denied
        </h2>
        <p class="text-muted mb-4">
            You don't have permission to access this page.
            Please contact your administrator if you think this is a mistake.
        </p>

        @if (role == "Student")
        {
            <a href="/Student/AcademicRecord/@userId" class="btn btn-primary">
                <i class="bi bi-arrow-left"></i> Back to My Page
            </a>
        }
        else if (role == "Faculty")
        {
            <a asp-controller="Faculty" asp-action="InputGrade" class="btn btn-primary">
                <i class="bi bi-arrow-left"></i> Back to My Page
            </a>
        }
        else if (role == "Admin")
        {
            <a asp-controller="Admin" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right"></i> Sign In
            </a>
        }
    </div>
</div>
