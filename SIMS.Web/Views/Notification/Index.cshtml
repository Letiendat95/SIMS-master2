@model List<SIMS.Web.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="page-title">Notifications</div>
        <div class="page-subtitle">@unreadCount unread notification(s)</div>
    </div>
    @if (unreadCount > 0)
    {
        <form asp-action="MarkAllAsRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-check-all"></i> Mark all as read
            </button>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-bell fs-1 text-muted d-block mb-3"></i>
            <p class="text-muted">No notifications yet.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            @foreach (var n in Model)
            {
                var iconClass = n.Type switch
                {
                    "Assignment" => "bi-file-earmark-text text-primary",
                    "Grade" => "bi-award-fill text-success",
                    "Enrollment" => "bi-journal-check text-info",
                    _ => "bi-bell text-secondary"
                };
                var bgStyle = n.IsRead ? "" : "background:var(--blue-pale);";

                <div class="d-flex align-items-start gap-3 p-3 border-bottom" style="@bgStyle">
                    <div style="width:40px;height:40px;border-radius:50%;background:var(--gray-100);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="bi @iconClass"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong class="@(n.IsRead ? "" : "text-primary")">@n.Title</strong>
                                @if (!n.IsRead)
                                {
                                    <span class="badge bg-primary ms-2" style="font-size:0.6rem;">NEW</span>
                                }
                            </div>
                            <small class="text-muted">@n.CreatedAt.ToString("MMM dd, HH:mm")</small>
                        </div>
                        <p class="text-muted mb-1 mt-1">@n.Message</p>
                        <div class="d-flex gap-2 mt-1">
                            @if (!string.IsNullOrEmpty(n.Link))
                            {
                                <a href="@n.Link" class="btn btn-sm btn-outline-primary py-0">
                                    <i class="bi bi-arrow-right"></i> View
                                </a>
                            }
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkAsRead" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.NotificationId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0">
                                        <i class="bi bi-check"></i> Mark read
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
