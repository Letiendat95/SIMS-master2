@using System.Linq
@model List<SIMS.Web.Models.Course>
@{
    ViewData["Title"] = "Input Grade";
}

<div class="page-header">
    <div class="page-title">Input Grade</div>
    <div class="page-subtitle">Step 1 — Select a course to grade students</div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header accent-success">
        <h5><i class="bi bi-pencil-square me-2"></i>Your Courses</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-book fs-1 d-block mb-3"></i>
                No courses available.
            </div>
        }
        else
        {
            <div class="list-group">
                @foreach (var course in Model)
                {
                    <a asp-action="SelectStudent" asp-route-courseId="@course.CourseId"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:42px;height:42px;background:linear-gradient(135deg,#059669,#10b981);border-radius:10px;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:.8rem;flex-shrink:0;">
                                @course.CourseCode.Split(' ')[0]
                            </div>
                            <div>
                                <strong>@course.CourseCode</strong> — @course.CourseName
                                <br /><small class="text-muted">@course.Credits credits</small>
                            </div>
                        </div>
                        <span class="badge bg-success">
                            <i class="bi bi-arrow-right"></i> Select
                        </span>
                    </a>
                }
            </div>
        }
    </div>
</div>
